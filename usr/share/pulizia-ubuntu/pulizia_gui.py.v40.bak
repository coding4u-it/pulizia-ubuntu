                 font=("Ubuntu", 9, "bold"),
                 bg=T("bg"), fg=T("error"),
                 justify="center", wraplength=650).pack(pady=6, padx=20)

        # --- Output log ---
        frame_log = tk.LabelFrame(
            win, text=" " + _("shred_section_log") + " ",
            font=("Ubuntu", 10, "bold"),
            bg=T("bg_widget"), fg=T("fg"),
            bd=2, relief="groove")
        frame_log.pack(fill=tk.BOTH, expand=True, padx=20, pady=6)

        self.shred_log = tk.Text(
            frame_log, wrap=tk.WORD, font=("Ubuntu Mono", 9),
            bg=T("bg_text"), fg=T("fg"),
            insertbackground=T("fg"),
            relief="flat", height=6)
        self.shred_log.pack(fill=tk.BOTH, expand=True, padx=8, pady=8)

        # --- Pulsanti azione ---
        frame_btn = tk.Frame(win, bg=T("bg"))
        frame_btn.pack(pady=10)

        self.btn_shred_file = tk.Button(
            frame_btn, text=_("shred_btn_file"),
            font=("Ubuntu", 10, "bold"),
            bg="#c0392b", fg="white", activebackground="#e74c3c",
            activeforeground="white", relief="flat",
            cursor="hand2", width=18, height=2,
            command=lambda: self._shred_esegui("file", win))
        self.btn_shred_file.pack(side=tk.LEFT, padx=4)

        self.btn_shred_dir = tk.Button(
            frame_btn, text=_("shred_btn_dir"),
            font=("Ubuntu", 10, "bold"),
            bg="#c0392b", fg="white", activebackground="#e74c3c",
            activeforeground="white", relief="flat",
            cursor="hand2", width=18, height=2,
            command=lambda: self._shred_esegui("dir", win))
        self.btn_shred_dir.pack(side=tk.LEFT, padx=4)

        tk.Button(frame_btn, text=_("shred_close"),
                  font=("Ubuntu", 10, "bold"),
                  bg="#7f8c8d", fg="white", relief="flat",
                  cursor="hand2", width=12, height=2,
                  command=win.destroy).pack(side=tk.LEFT, padx=4)

        win.bind("<Escape>", lambda e: win.destroy())

    def _shred_browse_file(self):
        """Apre dialog per selezionare un file."""
        percorso = filedialog.askopenfilename(
            title=_("shred_browse_file_title"))
        if percorso:
            self.shred_path_var.set(percorso)

    def _shred_browse_dir(self):
        """Apre dialog per selezionare una directory."""
        percorso = filedialog.askdirectory(
            title=_("shred_browse_dir_title"))
        if percorso:
            self.shred_dir_var.set(percorso)

    def _shred_log(self, testo):
        """Aggiunge una riga al log shred."""
        try:
            self.shred_log.insert(tk.END, testo + "\n")
            self.shred_log.see(tk.END)
            self.shred_log.update_idletasks()
        except Exception:
            pass

    def _shred_esegui(self, modo, finestra):
        """Esegue lo shred su file o directory."""
        # Verifica che shred esista
        if not shutil.which("shred"):
            messagebox.showerror(_("error_title"),
                                 _("shred_not_available"))
            return

        # Ottieni il percorso
        if modo == "file":
            percorso = self.shred_path_var.get().strip()
            etichetta = _("shred_file")
        else:
            percorso = self.shred_dir_var.get().strip()
            etichetta = _("shred_dir")

        if not percorso:
            messagebox.showwarning(_("shred_title"),
                                   _("shred_no_path"))
            return

        if not os.path.exists(percorso):
            messagebox.showerror(_("error_title"),
                                 _("shred_not_exists", percorso))
            return

        # Conta elementi
        if modo == "file":
            n_elementi = 1
            dimensione = os.path.getsize(percorso)
        else:
            n_elementi = 0
            dimensione = 0
            for root, dirs, files in os.walk(percorso):
                for f in files:
                    n_elementi += 1
                    try:
                        dimensione += os.path.getsize(os.path.join(root, f))
                    except Exception:
                        pass

        # Conferma esplicita
        msg = _("shred_confirm_msg",
                etichetta, percorso, n_elementi,
                self._bytes_a_human(dimensione))
        if not messagebox.askyesno(_("shred_confirm_title"), msg):
            return

        # Pulisci log
        try:
            self.shred_log.delete("1.0", tk.END)
        except Exception:
            pass

        # Disabilita pulsanti
        self.btn_shred_file.config(state=tk.DISABLED)
        self.btn_shred_dir.config(state=tk.DISABLED)

        # Esegui in thread separato
        threading.Thread(
            target=self._shred_worker,
            args=(modo, percorso, finestra),
            daemon=True
        ).start()

    def _shred_worker(self, modo, percorso, finestra):
        """Worker thread per lo shred."""
        try:
            passes = self.shred_passes_var.get()
            zero = self.shred_zero_var.get()
            remove = self.shred_remove_var.get()

            self._shred_log("=" * 60)
            self._shred_log(f"  SHRED - {datetime.now().strftime('%H:%M:%S')}")
            self._shred_log("=" * 60)
            self._shred_log(f"Percorso: {percorso}")
            self._shred_log(f"Passaggi: {passes}")
            self._shred_log(f"Aggiungi zero: {zero}")
            self._shred_log(f"Rimuovi file: {remove}")
            self._shred_log("")

            # Costruisci comando shred
            flags = [f"-n {passes}"]
            if zero:
                flags.append("-z")
            if remove:
                flags.append("-u")
            flags_str = " ".join(flags)

            file_list = []
            if modo == "file":
                file_list.append(percorso)
            else:
                for root, dirs, files in os.walk(percorso):
                    for f in files:
                        file_list.append(os.path.join(root, f))

            totale = len(file_list)
            self._shred_log(f"Elementi da cancellare: {totale}")
            self._shred_log("")

            completati = 0
            errori_count = 0

            for file_path in file_list:
                completati += 1
                nome = os.path.basename(file_path)

                # Usa sudo per file di root
                cmd_prefix = ""
                if not os.access(file_path, os.W_OK):
                    cmd_prefix = "sudo "

                cmd = f'{cmd_prefix}shred {flags_str} "{file_path}" 2>&1'
                ok, out = self._esegui_comando(cmd, timeout=600)

                if ok:
                    self._shred_log(f"[{completati}/{totale}] ✅ {nome}")
                else:
                    errori_count += 1
                    self._shred_log(f"[{completati}/{totale}] ⚠️  {nome}: {out[:100]}")

            # Rimuovi directory se era dir mode
            if modo == "dir" and os.path.exists(percorso):
                self._shred_log("")
                self._shred_log("Rimozione directory...")
                cmd_prefix = ""
                if not os.access(percorso, os.W_OK):
                    cmd_prefix = "sudo "
                self._esegui_comando(
                    f'{cmd_prefix}rm -rf "{percorso}" 2>&1', timeout=300)

            self._shred_log("")
            self._shred_log("=" * 60)
            if errori_count == 0:
                self._shred_log(f"✅ COMPLETATO - {completati} file cancellati")
            else:
                self._shred_log(f"⚠️  COMPLETATO con {errori_count} errori")
            self._shred_log("=" * 60)

            # Notifica
            self._invia_notifica(
                _("shred_notif_title"),
                _("shred_notif_msg", completati))

        except Exception as e:
            self._shred_log(f"\n❌ ERRORE: {e}")
        finally:
            try:
                self.btn_shred_file.config(state=tk.NORMAL)
                self.btn_shred_dir.config(state=tk.NORMAL)
            except Exception:
                pass

    def analizza_disco(self):
        win = tk.Toplevel(self.root)
        win.title(_("disk_title"))
        win.geometry("660x580")
        win.configure(bg=T("bg"))
        win.transient(self.root)

        tk.Label(win, text=_("disk_title"), font=("Ubuntu", 15, "bold"),
                 bg=T("bg"), fg=T("fg")).pack(pady=(12, 5))
        lbl_stato = tk.Label(win, text=_("disk_analyzing"),
                             font=("Ubuntu", 10, "italic"),
                             bg=T("bg"), fg=T("accent"))
        lbl_stato.pack(pady=4)

        frame_txt = tk.Frame(win, bg=T("bg"))
        frame_txt.pack(fill=tk.BOTH, expand=True, padx=15, pady=10)

        txt = tk.Text(frame_txt, wrap=tk.NONE, font=("Ubuntu Mono", 9),
                      bg=T("bg_text"), fg=T("fg"), relief="flat")
        txt.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sb = tk.Scrollbar(frame_txt, command=txt.yview, width=12,
                          relief="flat", bd=0)
        sb.pack(side=tk.RIGHT, fill=tk.Y)
        txt.config(yscrollcommand=sb.set)

        txt.insert(tk.END, f"{_('disk_path'):<45} {_('disk_size'):>12}\n")
        txt.insert(tk.END, "-" * 60 + "\n")

        def analizza():
            home = os.path.expanduser("~")
            percorsi = [
                ("/var/log", "/var/log"),
                ("/var/cache/apt", "/var/cache/apt"),
                ("/var/cache", "/var/cache"),
                ("/var/lib/snapd", "/var/lib/snapd"),
                ("/var/lib/docker", "/var/lib/docker"),
                ("/usr/lib", "/usr/lib"),
                ("/usr/share", "/usr/share"),
                ("/opt", "/opt"),
                (f"{home}/.cache", "~/.cache"),
                (f"{home}/.local/share/Trash", "~/.local/share/Trash"),
                (f"{home}/Downloads", "~/Downloads"),
                (f"{home}/.mozilla", "~/.mozilla"),
                (f"{home}/.config/google-chrome", "~/.config/google-chrome"),
                (f"{home}/.config/BraveSoftware", "~/.config/BraveSoftware"),
                ("/tmp", "/tmp"),
                ("/snap", "/snap"),
            ]
            risultati = []
            for percorso, etichetta in percorsi:
                if not os.path.exists(percorso):
                    continue
                try:
                    r = subprocess.run(["du", "-sb", percorso],
                                       capture_output=True, text=True,
                                       timeout=60)
                    if r.returncode == 0:
                        size = int(r.stdout.split()[0])
                        risultati.append((etichetta, size))
                except Exception:
                    pass
            risultati.sort(key=lambda x: x[1], reverse=True)
            for etichetta, size in risultati:
                txt.insert(tk.END, f"{etichetta:<45} "
                                   f"{self._bytes_a_human(size):>12}\n")
            totale = sum(r[1] for r in risultati)
            txt.insert(tk.END, "-" * 60 + "\n")
            txt.insert(tk.END, f"{_('disk_total'):<45} "
                               f"{self._bytes_a_human(totale):>12}\n")
            lbl_stato.config(text=_("disk_done"), fg=T("success"))

        threading.Thread(target=analizza, daemon=True).start()
        tk.Button(win, text=_("disk_close"), font=("Ubuntu", 10, "bold"),
                  bg="#7f8c8d", fg="white", relief="flat", width=14,
                  cursor="hand2", command=win.destroy).pack(pady=10)

    # ------------------------------------------------------------------
    # STATISTICHE STORICHE
    # ------------------------------------------------------------------
    def _salva_statistica(self, liberato):
        """Salva una statistica in stats.json."""
        try:
            os.makedirs(STATS_DIR, exist_ok=True)
            stats = {"pulizie": []}
            if os.path.exists(STATS_FILE):
                try:
                    with open(STATS_FILE, encoding="utf-8") as f:
                        stats = json.load(f)
                except Exception:
                    stats = {"pulizie": []}

            stats["pulizie"].append({
                "data": datetime.now().isoformat(),
                "liberato": liberato,
                "durata": 0,
            })

            with open(STATS_FILE, "w", encoding="utf-8") as f:
                json.dump(stats, f, indent=2, ensure_ascii=False)

            debug_log(f"Statistica salvata: {liberato} byte")
        except Exception as e:
            debug_log(f"Errore salvataggio statistica: {e}")

    def _carica_statistiche(self):
        """Carica le statistiche da stats.json."""
        if not os.path.exists(STATS_FILE):
            return []
        try:
            with open(STATS_FILE, encoding="utf-8") as f:
                stats = json.load(f)
            return stats.get("pulizie", [])
        except Exception:
            return []

    def mostra_statistiche(self):
        """Mostra la finestra delle statistiche con grafico."""
        pulizie = self._carica_statistiche()

        win = tk.Toplevel(self.root)
        win.title(_("stats_title"))
        win.geometry("900x650")
        win.configure(bg=T("bg"))
        win.transient(self.root)

        tk.Label(win, text=_("stats_title"), font=("Ubuntu", 15, "bold"),
                 bg=T("bg"), fg=T("fg")).pack(pady=(12, 6))

        if not pulizie:
            tk.Label(win, text=_("stats_no_data"),
                     font=("Ubuntu", 12),
                     bg=T("bg"), fg=T("fg_muted"),
                     justify="center").pack(expand=True, pady=50)
            tk.Button(win, text=_("stats_close"), font=("Ubuntu", 10, "bold"),
                      bg="#7f8c8d", fg="white", relief="flat", width=14,
                      cursor="hand2", command=win.destroy).pack(pady=15)
            return

        # --- Statistiche riassuntive ---
        frame_stats = tk.Frame(win, bg=T("bg_widget"))
        frame_stats.pack(fill=tk.X, padx=20, pady=8)

        totale = sum(p["liberato"] for p in pulizie)
        media = totale // len(pulizie)
        ultima = pulizie[-1]["data"][:19].replace("T", " ")
        prima = pulizie[0]["data"][:19].replace("T", " ")

        righe = [
            (_("stats_total"), str(len(pulizie))),
            (_("stats_freed_total"), self._bytes_a_human(totale)),
            (_("stats_avg"), self._bytes_a_human(media)),
            (_("stats_first"), prima),
            (_("stats_last"), ultima),
        ]
        for etichetta, valore in righe:
            r = tk.Frame(frame_stats, bg=T("bg_widget"))
            r.pack(fill=tk.X, padx=15, pady=2)
            tk.Label(r, text=f"{etichetta}:", font=("Ubuntu", 10, "bold"),
                     bg=T("bg_widget"), fg=T("fg_muted"),
                     width=25, anchor="w").pack(side=tk.LEFT)
            tk.Label(r, text=valore, font=("Ubuntu", 10),
                     bg=T("bg_widget"), fg=T("fg"),
                     anchor="w").pack(side=tk.LEFT)

        # --- Grafico ---
        frame_graph = tk.Frame(win, bg=T("bg"))
        frame_graph.pack(fill=tk.BOTH, expand=True, padx=20, pady=8)

        try:
            import matplotlib
            matplotlib.use("TkAgg")
            from matplotlib.figure import Figure
            from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

            fig = Figure(figsize=(9, 3.5), dpi=100, facecolor="#2c3e50")
            ax = fig.add_subplot(111, facecolor="#1c2833")

            # Mostra ultime 20 pulizie
            dati = pulizie[-20:]
            x = list(range(len(dati)))
            y = [d["liberato"] / (1024 * 1024) for d in dati]  # MB
            labels = [d["data"][5:10] for d in dati]  # MM-GG

            ax.plot(x, y, marker="o", color="#27ae60",
                    linewidth=2, markersize=6, markerfacecolor="#2ecc71")
            ax.fill_between(x, y, alpha=0.2, color="#27ae60")

            ax.set_xticks(x)
            ax.set_xticklabels(labels, rotation=45, ha="right",
                               color="#ecf0f1", fontsize=8)
            ax.set_ylabel("MB", color="#ecf0f1")
            ax.tick_params(axis="y", colors="#ecf0f1")
            ax.spines["bottom"].set_color("#7f8c8d")
            ax.spines["left"].set_color("#7f8c8d")
            ax.spines["top"].set_visible(False)
            ax.spines["right"].set_visible(False)
            ax.grid(axis="y", linestyle="--", alpha=0.3, color="#7f8c8d")
            ax.set_title(_("stats_chart_title"), color="#ecf0f1",
                         fontsize=11, fontweight="bold")
            fig.tight_layout()

            canvas = FigureCanvasTkAgg(fig, master=frame_graph)
            canvas.draw()
            canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)
        except ImportError:
            tk.Label(frame_graph, text=_("graph_no_mpl"),
                     font=("Ubuntu", 10), bg=T("bg"), fg=T("accent"),
                     justify="center").pack(expand=True)

        # --- Pulsanti ---
        frame_btn = tk.Frame(win, bg=T("bg"))
        frame_btn.pack(pady=10)

        def azzera():
            if not messagebox.askyesno(_("stats_title"),
                                       _("stats_reset_confirm")):
                return
            try:
                os.remove(STATS_FILE)
                messagebox.showinfo(_("stats_title"),
                                    "✅ Statistiche azzerate")
                win.destroy()
                self.mostra_statistiche()
            except Exception as e:
                messagebox.showerror(_("error_title"), str(e))

        tk.Button(frame_btn, text=_("stats_reset"),
                  font=("Ubuntu", 10, "bold"),
                  bg="#c0392b", fg="white", relief="flat", width=18,
                  height=2, cursor="hand2",
                  command=azzera).pack(side=tk.LEFT, padx=5)

        tk.Button(frame_btn, text=_("stats_close"),
                  font=("Ubuntu", 10, "bold"),
                  bg="#7f8c8d", fg="white", relief="flat", width=14,
                  height=2, cursor="hand2",
                  command=win.destroy).pack(side=tk.LEFT, padx=5)

        win.bind("<Escape>", lambda e: win.destroy())

    def salva_report(self):
        if not self.report_lines:
            return
        nome = f"report_pulizia_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        percorso = filedialog.asksaveasfilename(
            title=_("save_dialog_title"), initialfile=nome,
            defaultextension=".txt",
            filetypes=[("Testo", "*.txt"), ("Tutti", "*.*")])
        if not percorso:
            return
        try:
            with open(percorso, "w", encoding="utf-8") as f:
                f.write("\n".join(self.report_lines))
            messagebox.showinfo("OK", _("save_ok", percorso))
        except Exception as e:
            messagebox.showerror(_("error_title"), str(e))

    def copia_report(self):
        if not self.report_lines:
            return
        self.root.clipboard_clear()
        self.root.clipboard_append("\n".join(self.report_lines))
        messagebox.showinfo("OK", _("copy_ok"))

    def apri_guida(self):
        win = tk.Toplevel(self.root)
        win.title(_("help_title"))
        win.configure(bg=T("bg"))
        win.transient(self.root)
        win.minsize(800, 560)

        tk.Label(win, text=_("help_title"), font=("Ubuntu", 15, "bold"),
                 bg=T("bg"), fg=T("fg")).pack(pady=(12, 6))

        frame_main = tk.Frame(win, bg=T("bg"))
        frame_main.pack(fill=tk.BOTH, expand=True, padx=15, pady=5)

        frame_index = tk.Frame(frame_main, bg=T("bg_widget"), width=210)
        frame_index.pack(side=tk.LEFT, fill=tk.Y, padx=(0, 8))
        frame_index.pack_propagate(False)
        tk.Label(frame_index, text=_("help_index"),
                 font=("Ubuntu", 10, "bold"),
                 bg=T("bg_widget"), fg=T("fg")).pack(pady=6)

        listbox = tk.Listbox(frame_index, font=("Ubuntu", 10),
                             bg=T("bg_text"), fg=T("fg"),
                             selectbackground="#27ae60",
                             selectforeground="white",
                             relief="flat", bd=0, highlightthickness=0,
                             activestyle="none", cursor="hand2")
        listbox.pack(fill=tk.BOTH, expand=True, padx=6, pady=(0, 6))

        frame_content = tk.Frame(frame_main, bg=T("bg"))
        frame_content.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        txt = tk.Text(frame_content, wrap=tk.WORD, font=("Ubuntu", 10),
                      bg=T("bg_text"), fg=T("fg"),
                      insertbackground="white", relief="flat",
                      padx=15, pady=12, cursor="arrow")
        txt.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sb = tk.Scrollbar(frame_content, command=txt.yview, width=12,
                          relief="flat", bd=0)
        sb.pack(side=tk.RIGHT, fill=tk.Y)
        txt.config(yscrollcommand=sb.set)

        txt.tag_configure("section", font=("Ubuntu", 14, "bold"),
                          foreground="#2ecc71", spacing1=15, spacing3=8)
        txt.tag_configure("body", font=("Ubuntu", 10),
                          foreground="#ecf0f1",
                          lmargin1=10, lmargin2=10, spacing1=3, spacing3=3)
        txt.tag_configure("bullet", font=("Ubuntu", 10),
                          foreground="#f39c12",
                          lmargin1=25, lmargin2=40, spacing1=2, spacing3=2)
        txt.tag_configure("code", font=("Ubuntu Mono", 9),
                          foreground="#1abc9c", background="#2c3e50",
                          lmargin1=40, lmargin2=40, spacing1=1, spacing3=1)

        sezioni = GUIDE_CONTENT.get(CURRENT_LANG, GUIDE_CONTENT["en"])
        markers = []
        for titolo, contenuto in sezioni:
            marker = f"sec_{len(markers)}"
            txt.mark_set(marker, tk.END)
            markers.append(marker)
            txt.insert(tk.END, f"> {titolo}\n", "section")
            for riga in contenuto.strip().split("\n"):
                if not riga.strip():
                    txt.insert(tk.END, "\n")
                elif riga.strip()[:1] in "*-" or \
                        riga.strip()[:2] in ("D:", "R:", "Q:", "A:"):
                    txt.insert(tk.END, "  " + riga + "\n", "bullet")
                elif riga.strip().startswith(("sudo", "systemctl", "cat ",
                                              "/usr", "groups", "apt-",
                                              "/etc", "/var", "rm ",
                                              "notify-", "grep", "python3",
                                              "du ")):
                    txt.insert(tk.END, "      " + riga.strip() + "\n", "code")
                else:
                    txt.insert(tk.END, riga + "\n", "body")
            txt.insert(tk.END, "\n")
            listbox.insert(tk.END, f"  {titolo}")

        def vai(event=None):
            sel = listbox.curselection()
            if sel and 0 <= sel[0] < len(markers):
                txt.see(markers[sel[0]])
        listbox.bind("<<ListboxSelect>>", vai)
        listbox.bind("<Return>", vai)
        listbox.selection_set(0)

        tk.Button(win, text=_("help_close"), font=("Ubuntu", 10, "bold"),
                  bg="#7f8c8d", fg="white", relief="flat", width=14,
                  height=2, cursor="hand2",
                  command=win.destroy).pack(pady=10)
        win.bind("<Escape>", lambda e: win.destroy())

        win.update_idletasks()
        win.geometry("")
        win.update_idletasks()
        larg = max(win.winfo_reqwidth(), 820)
        alt = max(win.winfo_reqheight(), 620)
        sw = win.winfo_screenwidth()
        sh = win.winfo_screenheight()
        win.geometry(f"{larg}x{alt}+{(sw-larg)//2}+{(sh-alt)//2}")
        win.focus_set()

    def _cron_service_attivo(self):
        try:
            r = subprocess.run(["systemctl", "is-active", "cron"],
                               capture_output=True, text=True, timeout=5)
            s = (r.stdout or "").strip().lower()
            if s == "active":
                return True
            if s in ("inactive", "failed", "deactivating"):
                return False
            r2 = subprocess.run(["systemctl", "is-enabled", "cron"],
                                capture_output=True, text=True, timeout=5)
            e = (r2.stdout or "").strip().lower()
            if e == "enabled":
                return True
            if e in ("disabled", "masked"):
                return False
            return None
        except Exception:
            return None

    def apri_schedulazione(self):
        cron_file = "/etc/cron.d/pulizia-ubuntu"
        win = tk.Toplevel(self.root)
        win.title(_("sched_title"))
        win.configure(bg=T("bg"))
        win.transient(self.root)
        win.grab_set()
        win.resizable(False, False)
        win.minsize(560, 620)

        tk.Label(win, text=_("sched_title"), font=("Ubuntu", 15, "bold"),
                 bg=T("bg"), fg=T("fg")).pack(pady=(15, 5))
        tk.Label(win, text=_("sched_desc"), font=("Ubuntu", 9, "italic"),
                 bg=T("bg"), fg=T("fg_muted"),
                 justify="center").pack(pady=(0, 10))

        fs = tk.LabelFrame(win, text=" " + _("sched_service_title") + " ",
                           font=("Ubuntu", 10, "bold"),
                           bg=T("bg_widget"), fg=T("fg"), bd=2, relief="groove")
        fs.pack(fill=tk.X, padx=20, pady=6)

        cron_attivo = self._cron_service_attivo()
        if cron_attivo is None:
            t_serv, c_serv = _("sched_service_unknown"), "#e67e22"
        elif cron_attivo:
            t_serv, c_serv = _("sched_service_active"), "#2ecc71"
        else:
            t_serv, c_serv = _("sched_service_inactive"), "#e74c3c"

        lbl_serv = tk.Label(fs, text=t_serv, font=("Ubuntu", 10, "bold"),
                            bg=T("bg_widget"), fg=c_serv, anchor="w")
        lbl_serv.pack(fill=tk.X, padx=10, pady=(8, 2))

        voce = os.path.exists(cron_file)
        t_voce = _("sched_entry_active") if voce else _("sched_entry_inactive")
        c_voce = "#2ecc71" if voce else "#95a5a6"
        lbl_voce = tk.Label(fs, text=t_voce, font=("Ubuntu", 10, "bold"),
                            bg=T("bg_widget"), fg=c_voce, anchor="w")
        lbl_voce.pack(fill=tk.X, padx=10, pady=(2, 8))

        fb = tk.Frame(fs, bg=T("bg_widget"))
        fb.pack(pady=(0, 10), padx=10, fill=tk.X)

        def agg_stato():
            a = self._cron_service_attivo()
            if a is None:
                lbl_serv.config(text=_("sched_service_unknown"), fg=T("accent"))
            elif a:
                lbl_serv.config(text=_("sched_service_active"), fg=T("success"))
            else:
                lbl_serv.config(text=_("sched_service_inactive"), fg=T("error"))
            if os.path.exists(cron_file):
                lbl_voce.config(text=_("sched_entry_active"), fg=T("success"))
            else:
                lbl_voce.config(text=_("sched_entry_inactive"), fg=T("fg_muted"))
            btn_en.config(state=tk.NORMAL if a is False else tk.DISABLED)
            btn_di.config(state=tk.NORMAL if a is True else tk.DISABLED)

        def abilita():
            if not self._assicura_sudo():
                return
            ok, out = self._esegui_comando("sudo systemctl enable --now cron")
            if ok:
                messagebox.showinfo(_("sched_service_title"),
                                    _("sched_service_enabled"))
                agg_stato()
            else:
                messagebox.showerror(_("error_title"), out)

        def disabilita():
            if not messagebox.askyesno(_("confirm_title"),
                                       _("sched_service_disable_confirm")):
                return
            if not self._assicura_sudo():
                return
            ok, out = self._esegui_comando(
                "sudo systemctl stop cron && sudo systemctl disable cron")
            if ok:
                messagebox.showinfo(_("sched_service_title"),
                                    _("sched_service_disabled"))
                agg_stato()
            else:
                messagebox.showerror(_("error_title"), out)

        btn_en = tk.Button(fb, text=_("sched_service_enable"),
                           font=("Ubuntu", 9, "bold"),
                           bg="#27ae60", fg="white", relief="flat",
                           cursor="hand2", width=18, command=abilita)
        btn_di = tk.Button(fb, text=_("sched_service_disable"),
                           font=("Ubuntu", 9, "bold"),
                           bg="#c0392b", fg="white", relief="flat",
                           cursor="hand2", width=18, command=disabilita)
        btn_en.pack(side=tk.LEFT, padx=5)
        btn_di.pack(side=tk.LEFT, padx=5)
        if cron_attivo is True:
            btn_en.config(state=tk.DISABLED)
        elif cron_attivo is False:
            btn_di.config(state=tk.DISABLED)

        fc = tk.LabelFrame(win, text=" " + _("sched_config_title") + " ",
                           font=("Ubuntu", 10, "bold"),
                           bg=T("bg_widget"), fg=T("fg"), bd=2, relief="groove")
        fc.pack(fill=tk.X, padx=20, pady=6)
        inner = tk.Frame(fc, bg=T("bg_widget"))
        inner.pack(padx=15, pady=10, fill=tk.X)

        tk.Label(inner, text=_("sched_freq") + ":",
                 font=("Ubuntu", 10, "bold"),
                 bg=T("bg_widget"), fg=T("fg")).grid(
            row=0, column=0, sticky="w", pady=(4, 2))
        freq_var = tk.StringVar(value="weekly")
        ffr = tk.Frame(inner, bg=T("bg_widget"))
        ffr.grid(row=1, column=0, columnspan=2, sticky="w", padx=20,
                 pady=(0, 8))
        for val, key in [("daily", "sched_daily"),
                         ("weekly", "sched_weekly"),
                         ("monthly", "sched_monthly")]:
            tk.Radiobutton(ffr, text=_(key), variable=freq_var, value=val,
                           font=("Ubuntu", 10),
                           bg=T("bg_widget"), fg=T("fg"),
                           selectcolor="#34495e",
                           activebackground="#34495e",
                           activeforeground="#1abc9c",
                           anchor="w", cursor="hand2").pack(fill=tk.X, pady=1)

        tk.Label(inner, text=_("sched_time") + ":",
                 font=("Ubuntu", 10, "bold"),
                 bg=T("bg_widget"), fg=T("fg")).grid(
            row=2, column=0, sticky="w", pady=(4, 2))
        ora_var = tk.StringVar(value="3")
        tk.Spinbox(inner, from_=0, to=23, textvariable=ora_var, width=5,
                   font=("Ubuntu", 10), bg=T("bg_text"), fg=T("fg"),
                   buttonbackground="#2c3e50", relief="flat",
                   insertbackground="white").grid(
            row=2, column=1, sticky="w", padx=8, pady=(4, 2))

        tk.Label(inner, text=_("sched_day") + ":",
                 font=("Ubuntu", 10, "bold"),
                 bg=T("bg_widget"), fg=T("fg")).grid(
            row=3, column=0, sticky="w", pady=(4, 2))
        giorni = [("0", "sched_sun"), ("1", "sched_mon"), ("2", "sched_tue"),
                  ("3", "sched_wed"), ("4", "sched_thu"), ("5", "sched_fri"),
                  ("6", "sched_sat")]
        combo = ttk.Combobox(inner, state="readonly", width=20,
                             font=("Ubuntu", 10),
                             values=[f"{g[0]} - {_(g[1])}" for g in giorni])
        combo.current(1)
        combo.grid(row=3, column=1, sticky="w", padx=8, pady=(4, 2))

        tk.Label(win, text=_("sched_note"), font=("Ubuntu", 8, "italic"),
                 bg=T("bg"), fg=T("fg_muted"), wraplength=520,
                 justify="left").pack(pady=6, padx=20)

        def salva():
            freq = freq_var.get()
            try:
                ora = int(ora_var.get())
                if not 0 <= ora <= 23:
                    raise ValueError()
            except ValueError:
                messagebox.showerror(_("error_title"), _("sched_err_time"))
                return
            gt = combo.get()
            g = gt.split(" - ")[0] if " - " in gt else "0"
            if freq == "daily":
                expr = f"0 {ora} * * *"
            elif freq == "weekly":
                expr = f"0 {ora} * * {g}"
            else:
                expr = f"0 {ora} 1 * *"
            if not self._assicura_sudo():
                return
            self._installa_cron(expr, win)

        def rimuovi():
            if not os.path.exists(cron_file):
                messagebox.showinfo(_("sched_title"),
                                    _("sched_entry_inactive"))
                return
            if not messagebox.askyesno(_("sched_remove_confirm_title"),
                                       _("sched_remove_confirm_msg")):
                return
            if not self._assicura_sudo():
                return
            self._rimuovi_cron(win)

        fbt = tk.Frame(win, bg=T("bg"))
        fbt.pack(pady=10)
        tk.Button(fbt, text=_("sched_save"), font=("Ubuntu", 10, "bold"),
                  bg="#27ae60", fg="white", relief="flat", width=14,
                  height=2, cursor="hand2", command=salva).pack(
            side=tk.LEFT, padx=4)
        tk.Button(fbt, text=_("sched_remove"), font=("Ubuntu", 10, "bold"),
                  bg="#c0392b", fg="white", relief="flat", width=14,
                  height=2, cursor="hand2", command=rimuovi).pack(
            side=tk.LEFT, padx=4)
        tk.Button(fbt, text=_("sched_close"), font=("Ubuntu", 10),
                  bg="#7f8c8d", fg="white", relief="flat", width=10,
                  height=2, cursor="hand2", command=win.destroy).pack(
            side=tk.LEFT, padx=4)

        win.update_idletasks()
        win.geometry("")
        win.update_idletasks()
        larg = max(win.winfo_reqwidth(), 560)
        alt = max(win.winfo_reqheight(), 620)
        sw = win.winfo_screenwidth()
        sh = win.winfo_screenheight()
        win.geometry(f"{larg}x{alt}+{(sw-larg)//2}+{(sh-alt)//2}")

    def _installa_cron(self, espressione, finestra):
        script_content = r'''#!/bin/bash
LOG=/var/log/pulizia_ubuntu.log
echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Inizio pulizia ===" >> "$LOG"
PRIMA=$(df -B1 / | tail -1 | awk '{print $4}')
apt-get autoremove --purge -y >> "$LOG" 2>&1
apt-get clean >> "$LOG" 2>&1
apt-get autoclean >> "$LOG" 2>&1
journalctl --vacuum-time=3d >> "$LOG" 2>&1
if command -v snap &>/dev/null; then
    snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}' | \
    while read nome rev; do
        [ -n "$nome" ] && [ -n "$rev" ] && \
            snap remove "$nome" --revision="$rev" >> "$LOG" 2>&1
    done
fi
find /tmp -type f -atime +7 -delete 2>/dev/null
find /var/tmp -type f -atime +30 -delete 2>/dev/null
for pkg in $(dpkg -l | awk '/^rc/{print $2}'); do
    apt-get purge -y "$pkg" >> "$LOG" 2>&1
done
DOPO=$(df -B1 / | tail -1 | awk '{print $4}')
LIBERATO=$(( DOPO - PRIMA ))
if [ "$LIBERATO" -gt 0 ]; then
    LIB=$(numfmt --to=iec --suffix=B "$LIBERATO" 2>/dev/null || echo "${LIBERATO}B")
else
    LIB="0B"
fi
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Completata. Liberati: $LIB" >> "$LOG"
UTENTE=$(who | grep -v root | head -1 | awk '{print $1}')
if [ -n "$UTENTE" ]; then
    UID_U=$(id -u "$UTENTE" 2>/dev/null)
    DISP=$(who | grep "^$UTENTE " | grep -o ':[0-9.]*' | head -1)
    [ -z "$DISP" ] && DISP=":0"
    [ -n "$UID_U" ] && runuser -u "$UTENTE" -- env DISPLAY="$DISP" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_U/bus" \
        notify-send -i pulizia-ubuntu -a "Pulizia Ubuntu" -t 10000 \
        "Pulizia automatica completata" "Spazio liberato: $LIB" 2>/dev/null
fi
echo "" >> "$LOG"
'''
        try:
            tmp = "/tmp/pulizia_cron_tmp.sh"
            with open(tmp, "w") as f:
                f.write(script_content)
            os.chmod(tmp, 0o755)
        except Exception as e:
            messagebox.showerror(_("error_title"), str(e))
            return
        ok, out = self._esegui_comando(
            f"sudo mv {tmp} /usr/local/bin/pulizia_ubuntu_cron.sh && "
            f"sudo chmod 755 /usr/local/bin/pulizia_ubuntu_cron.sh")
        if not ok:
            messagebox.showerror(_("error_title"), out)
            return
        cron_content = ("# Pulizia automatica Ubuntu\n"
                        "SHELL=/bin/bash\n"
                        "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:"
                        "/usr/sbin:/usr/bin\n"
                        f"{espressione} root "
                        "/usr/local/bin/pulizia_ubuntu_cron.sh\n")
        try:
            tmp_c = "/tmp/pulizia_cron_tmp.cron"
            with open(tmp_c, "w") as f:
                f.write(cron_content)
        except Exception as e:
            messagebox.showerror(_("error_title"), str(e))
            return
        ok, out = self._esegui_comando(
            f"sudo mv {tmp_c} /etc/cron.d/pulizia-ubuntu && "
            f"sudo chmod 644 /etc/cron.d/pulizia-ubuntu")
        if not ok:
            messagebox.showerror(_("error_title"), out)
            return
        messagebox.showinfo(_("sched_ok_title"),
                            _("sched_ok_msg", espressione))
        finestra.destroy()

    def _rimuovi_cron(self, finestra):
        ok, out = self._esegui_comando(
            "sudo rm -f /etc/cron.d/pulizia-ubuntu "
            "/usr/local/bin/pulizia_ubuntu_cron.sh")
        if ok:
            messagebox.showinfo(_("sched_removed_title"),
                                _("sched_removed_msg"))
            finestra.destroy()
        else:
            messagebox.showerror(_("error_title"), out)

    def _invia_notifica(self, titolo, messaggio):
        try:
            subprocess.Popen(
                ["notify-send", "-i", "pulizia-ubuntu", "-a", APP_NAME,
                 "-t", "8000", titolo, messaggio],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            debug_log(f"notify err: {e}")

    def _set_pulsanti(self, abilitato):
        stato = tk.NORMAL if abilitato else tk.DISABLED
        self.btn_esegui.config(state=stato)
        self.btn_esci.config(state=stato)
        self.btn_menu.config(state=stato)
        self.btn_guida.config(state=stato)

    def esci(self):
        if self.in_esecuzione:
            messagebox.showwarning("⏳", _("exit_running"))
            return
        if messagebox.askyesno(_("exit_title"), _("exit_msg")):
            self.password_sudo = None
            self.root.destroy()


if __name__ == "__main__":
    debug_log("--- Avvio main ---")
    root = tk.Tk()
    app = PuliziaApp(root)
    root.mainloop()
    debug_log("--- Chiusura app ---")
